---
---
<section style="margin-bottom: 40px; margin-top: 20px;">
  <div class="dialogue-container" style="display: flex; gap: 15px; align-items: flex-end;">
    
    <!-- Character Sprite with Breathing and Basketball Spin Animations -->
    <div class="avatar-container" style="text-align: center; flex-shrink: 0;">
      <div 
        id="hero-pixel-avatar"
        class="pixel-avatar anim-basket" 
        role="img" 
        aria-label="Player 1 Avatar (Omar)"
        title="Click Omar to toggle basketball spin / breathing!"
      ></div>
    </div>

    <!-- Speech Balloon (Dialogue Box) -->
    <div class="nes-balloon from-left is-dark dialogue-balloon" id="intro-balloon" style="flex: 1; min-width: 0; cursor: pointer;" title="Click to skip typing">
      <p class="typewriter-line" data-text="Hello! I'm Omar.">Hello! I'm Omar.</p>
      <p class="typewriter-line" data-text="I love building robust, performant web applications and automating my life." style="margin-top: 10px;">I love building robust, performant web applications and automating my life.</p>
    </div>

  </div>
</section>

<script is:inline>
  (() => {
    const initTypewriter = () => {
      const balloon = document.getElementById('intro-balloon');
      if (!balloon) return;

      const lines = balloon.querySelectorAll('.typewriter-line');
      let skipTyping = false;
      let activeInterval = null;

      // Extract text content to avoid duplicating text manually
      const texts = Array.from(lines).map(line => line.getAttribute('data-text') || line.innerText);

      // Instantly clear content to start typing
      lines.forEach(line => {
        line.innerText = '';
        line.style.display = 'none';
      });

      let currentLineIdx = 0;

      const startTypingLine = (lineIdx) => {
        if (lineIdx >= lines.length) return;

        const line = lines[lineIdx];
        const targetText = texts[lineIdx];
        line.style.display = 'block';

        // Append blinking block cursor
        const cursor = document.createElement('span');
        cursor.className = 'retro-cursor';
        line.appendChild(cursor);

        let charIdx = 0;
        activeInterval = setInterval(() => {
          if (skipTyping) {
            clearInterval(activeInterval);
            line.innerText = targetText;
            return;
          }

          if (charIdx < targetText.length) {
            const char = targetText.charAt(charIdx);
            cursor.before(char);
            charIdx++;
          } else {
            clearInterval(activeInterval);
            cursor.remove();
            currentLineIdx++;
            startTypingLine(currentLineIdx);
          }
        }, 25);
      };

      // Click to skip typing
      balloon.addEventListener('click', () => {
        if (skipTyping) return;
        skipTyping = true;
        clearInterval(activeInterval);
        
        lines.forEach((line, idx) => {
          line.style.display = 'block';
          line.innerText = texts[idx];
          const cursor = line.querySelector('.retro-cursor');
          if (cursor) cursor.remove();
        });
      });

      // Start typing sequence
      startTypingLine(currentLineIdx);
    };

    const initAvatar = () => {
      const avatar = document.getElementById('hero-pixel-avatar');
      if (!avatar) return;

      let spinTimer = null;

      const setAvatarState = (state) => {
        avatar.classList.remove('anim-idle', 'anim-basket');
        avatar.classList.add(`anim-${state}`);
      };

      const playBasketIntro = () => {
        if (spinTimer) clearTimeout(spinTimer);

        // Spin the basketball on initial load
        setAvatarState('basket');

        // Then settle into breath (idle)
        spinTimer = setTimeout(() => {
          setAvatarState('idle');
        }, 2400);
      };

      // Play basketball spin on load, then breathe
      playBasketIntro();

      // Clicking the avatar toggles between spinning ball and idle breath
      avatar.addEventListener('click', () => {
        if (spinTimer) clearTimeout(spinTimer);
        if (avatar.classList.contains('anim-idle')) {
          setAvatarState('basket');
        } else {
          setAvatarState('idle');
        }
      });
    };

    const init = () => {
      initTypewriter();
      initAvatar();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .pixel-avatar {
    --avatar-size: 150px;
    width: var(--avatar-size);
    height: var(--avatar-size);
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    display: inline-block;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.45));
    transition: filter 0.2s, transform 0.15s ease;
    user-select: none;
    cursor: pointer;
    background-repeat: no-repeat;
  }

  .pixel-avatar:hover {
    filter: drop-shadow(0 0 10px rgba(32, 156, 238, 0.7));
    transform: translateY(-2px);
  }

  /* Idle Breath State: 4 Frames */
  .pixel-avatar.anim-idle {
    background-image: url('/profile-idle.png');
    background-size: calc(var(--avatar-size) * 4) var(--avatar-size);
    animation: playerIdle 1.4s steps(4) infinite;
  }

  /* Basketball Spin State: 8 Frames */
  .pixel-avatar.anim-basket {
    background-image: url('/profile-basket.png');
    background-size: calc(var(--avatar-size) * 8) var(--avatar-size);
    animation: playerBasket 0.8s steps(8) infinite;
  }

  @keyframes playerIdle {
    from { background-position: 0 0; }
    to { background-position: calc(var(--avatar-size) * -4) 0; }
  }

  @keyframes playerBasket {
    from { background-position: 0 0; }
    to { background-position: calc(var(--avatar-size) * -8) 0; }
  }

  /* Ensure the dialogue box stays side-by-side with the image on tiny screens */
  @media (max-width: 600px) {
    .dialogue-container {
      gap: 10px !important;
    }
    .pixel-avatar {
      --avatar-size: 130px;
    }
    .dialogue-balloon {
      padding: 1rem !important;
    }
    .dialogue-balloon p {
      font-size: 0.65rem !important;
    }
  }
</style>
